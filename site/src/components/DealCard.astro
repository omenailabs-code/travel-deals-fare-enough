---
const { deal } = Astro.props;
---
<div class="bg-navy-800 border border-white/10 p-6 rounded-xl hover:border-amber-500 transition-colors duration-300 group">

  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class="text-2xl font-bold font-space text-white">{deal.resort || (deal.origin + ' → ' + deal.destination)}</h3>
      {deal.stars && (
        <div class="flex items-center gap-1 mt-1">
          {Array.from({length: deal.stars}).map(() => (
            <span class="text-amber-400 text-lg">★</span>
          ))}
          {Array.from({length: 5 - (deal.stars || 0)}).map(() => (
            <span class="text-gray-600 text-lg">☆</span>
          ))}
        </div>
      )}
      <p class="text-amber font-bold text-3xl mt-2">{deal.price} {deal.currency}</p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <div class="bg-amber/10 text-amber px-3 py-1 rounded-full text-sm font-bold border border-amber/20">
        {deal.confidence}/10 Confidence
      </div>
      {deal.is_all_inclusive && (
        <div class="bg-green-500/10 text-green-500 px-3 py-1 rounded-full text-sm font-bold border border-green-500/20">
          All-Inclusive
        </div>
      )}
    </div>
  </div>
  
  <p class="text-gray-300 mb-6 italic">
    "{deal.description}"
  </p>
  
  <div class="flex items-center justify-between">
    <span class="text-xs text-gray-500">Verified {deal.observed_days} days ago</span>
    <a href="#" class="bg-amber text-navy-900 px-4 py-2 rounded font-bold group-hover:bg-amber-400 transition-colors">
      View Deal
    </a>
  </div>
</div>
